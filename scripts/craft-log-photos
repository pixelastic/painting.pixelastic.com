#!/usr/bin/env zsh
# List Dropbox photos taken during a craft session time range
# Outputs a JSON array of absolute file paths
# Usage:
# $ craft-log-photos --from "2026-09-15 20.00" --to "2026-09-15 23.30"
set -e

zparseopts -E -D \
  -from:=flagFrom \
  -to:=flagTo

local startDatetime="${flagFrom[2]//./:}"
local endDatetime="${flagTo[2]//./:}"

local cameraDirectory="${DROPBOX_CAMERA_DIR:-/home/tim/perso/Dropbox/Chargements appareil photo}"

# Find photos by mtime between start and end + 2h buffer
local endEpoch=$(( $(date --date="$endDatetime" +%s) + 7200 ))
local endTimestamp="$(date --date="@$endEpoch" "+%Y-%m-%d %H:%M")"

local results="$(find "$cameraDirectory" -maxdepth 1 -type f -newermt "$startDatetime" ! -newermt "$endTimestamp" | sort)"

# No matching photos
if [[ "$results" == "" ]]; then
  echo "[]"
  exit 0
fi

echo "$results" | jo -a
